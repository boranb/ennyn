  },
  "review": {
    "impactRequiredGlobs": [".ennyn/config.json", "checks/**", "core/config.mjs", "metrics/szz.mjs", "setup/scan.mjs", "test/verdicts/**"],
    "cochange": [
      { "paths": ["README.md"], "docs": ["README.tr.md"], "note": "the twins change together" },
      { "paths": ["README.tr.md"], "docs": ["README.md"], "note": "the twins change together" },
      { "paths": ["core/*.mjs", "checks/*.mjs", "metrics/*.mjs", "impact/*.mjs", "plan/*.mjs", "setup/*.mjs", "side-copy/*.mjs", "adapters/**/*.mjs"], "docs": ["docs/modules.md"], "note": "module contracts" },
      { "paths": ["core/config.mjs"], "docs": ["DESIGN.md"], "note": "the config table" },
      { "paths": ["i18n/en.json"], "docs": ["i18n/tr.json"] },
      { "paths": ["core/*.mjs", "checks/*.mjs", "metrics/*.mjs", "impact/*.mjs", "plan/*.mjs", "setup/*.mjs", "side-copy/*.mjs", "scripts/**", "adapters/**", "hooks/**", "skills/**", "agents/**", "styles/**"], "docs": ["CHANGELOG.md"], "note": "user-visible changes" }
    ]
  }
}

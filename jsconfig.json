{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "types": ["node"]
  },
  "include": ["plugin/core", "plugin/checks", "plugin/side-copy", "plugin/impact", "plugin/metrics", "plugin/plan", "plugin/setup", "plugin/adapters", "plugin/scripts", "scripts"]
}
